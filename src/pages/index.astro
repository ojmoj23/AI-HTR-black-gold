---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import HomeContent from '../components/HomeContent.astro';
import Footer from '../components/Footer.astro';

const lang = 'en' as const;
---

<Layout
  lang={lang}
  title="AIR — Smart Software for Document Digitisation"
  description="AIR is a team of software developers and digitisation specialists helping institutions worldwide unlock the value of their document collections."
>
  <Navbar lang={lang} page="home" />
  <main>
    <HomeContent lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
