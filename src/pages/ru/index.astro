---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import HomeContent from '../../components/HomeContent.astro';
import Footer from '../../components/Footer.astro';

const lang = 'ru' as const;
---

<Layout
  lang={lang}
  title="АИР — Умное ПО для оцифровки документов"
  description="АИР — команда разработчиков и специалистов по оцифровке, помогающая учреждениям по всему миру раскрыть ценность их документальных коллекций."
>
  <Navbar lang={lang} page="home" />
  <main>
    <HomeContent lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
